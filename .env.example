CANVAS_AUTH_KEY=your-canvas-personal-access-token
CANVAS_BASE_URL=https://canvas.uoregon.edu
GOOGLE_TASKLIST_NAME=School
# Prefer selecting the existing list by ID after the initial setup.
# GOOGLE_TASKLIST_ID=
SYNC_TIMEZONE=America/Los_Angeles
# Optional explicit course IDs (overrides automatic current-course discovery):
# CANVAS_COURSE_IDS=12345,67890
PLANNER_LOOKBACK_DAYS=120
PLANNER_AHEAD_DAYS=365
# Explicit deadline exceptions, keyed by the source identity printed by --dry-run:
# CANVAS_DUE_OVERRIDES={"canvas.uoregon.edu|assignment|12345|67890":"2026-10-01T23:59:00-07:00"}
